{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rower-prototype",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),p=require('path');const root=p.join(process.cwd(),'prototype');http.createServer((q,s)=>{let f=q.url==='/'?'/index.html':q.url.split('?')[0];f=p.join(root,decodeURIComponent(f));fs.readFile(f,(e,d)=>{if(e){s.writeHead(404);s.end('not found');}else{s.writeHead(200,{'Content-Type':'text/html; charset=utf-8'});s.end(d);}});}).listen(4173,()=>console.log('rower prototype on http://localhost:4173'));"
      ],
      "port": 4173
    }
  ]
}
